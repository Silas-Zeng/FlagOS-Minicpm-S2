ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/corex/bin/clang++

cflags = -DTORCH_EXTENSION_NAME=biv150_native_w8a8 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /usr/local/lib/python3.12/site-packages/torch/include -isystem /usr/local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/corex/include -isystem /usr/local/include/python3.12 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3
post_cflags = -D__ILUVATAR__
cuda_cflags = -DTORCH_EXTENSION_NAME=biv150_native_w8a8 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /usr/local/lib/python3.12/site-packages/torch/include -isystem /usr/local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/corex/include -isystem /usr/local/include/python3.12 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -D__ILUVATAR__ -D__ILUVATAR_WORKAROUND__ -D__ILUVATAR_DIAG__ -cl-single-precision-constant -fPIC -mllvm --bonus-inst-threshold=0 -mllvm --skip-double -fclang-abi-compat=16 -D__MR__ -O3 -x ivcore --cuda-gpu-arch=ivcore11 --cuda-path=/usr/local/corex -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/usr/local/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/corex/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build native_w8a8.o: compile /workspace/experiments/minicpm-s2/code/main-pr24-1ad9a708-20261024T105037Z/csrc/iluvatar/native_w8a8.cpp
build native_w8a8.cuda.o: cuda_compile /workspace/experiments/minicpm-s2/code/main-pr24-1ad9a708-20261024T105037Z/csrc/iluvatar/native_w8a8.cu





build biv150_native_w8a8.so: link native_w8a8.o native_w8a8.cuda.o

default biv150_native_w8a8.so
