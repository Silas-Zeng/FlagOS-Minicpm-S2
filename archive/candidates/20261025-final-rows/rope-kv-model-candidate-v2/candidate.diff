+
+_FEATURE = "VLLM_FL_BIV150_ROPE_KV"
+_REGISTERED = False
+_KERNEL_READY = False
+_KERNEL = None
+_LAYERS = {}
+_OBSERVED = set()
+_SOURCE_PINS = {
+    "attention": "3414faca4cc04c699dbb880ba1761230e1ed97035f2934604cad9a5490f4dba1",
+    "rotary": "c81804498f08f072356a26b41967f211475df2694dabf5da9f488c074d1fdef5",
