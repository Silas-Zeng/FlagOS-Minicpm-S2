+class _QueryBuffers:
+    def __init__(self, runner, layer, backend):
+        self.layer, self.backend = layer, backend
+        # 在 load 后、profile 前分配；只 512B GPU permutation + 260B 不变 cu_q。
+        self.permutation_cpu = torch.empty(64, dtype=torch.int64, pin_memory=True)
+        self.permutation_numpy = self.permutation_cpu.numpy()
+        self.permutation_gpu = torch.empty(64, dtype=torch.int64, device=runner.device)
+        self.query_start = torch.arange(65, dtype=torch.int32, device=runner.device)
+
+    def physical_indices(self, runner, indices, proof, plan):
+        n = proof["S"]
+        if (not isinstance(indices, torch.Tensor) or indices.shape != (n,)
+                or indices.dtype != torch.int32 or indices.device != runner.device or indices.stride() != (1,)):
+            return None
+        if plan is None:
+            return indices
+        # 此 wrapper 位于原 synchronize_input_prep 范围；原 event 保护 pinned host 重用。
+        # 原 GPU logits_indices 是请求序，P permutation 是物理序→请求序。
+        np.copyto(self.permutation_numpy[:n], plan.permutation, casting="no")
+        self.permutation_gpu[:n].copy_(self.permutation_cpu[:n], non_blocking=True)
+        return indices[self.permutation_gpu[:n]]
+
+
+def _tensor_shape(value, shape, dtype, device):
+    return (isinstance(value, torch.Tensor) and tuple(value.shape) == shape
+            and value.dtype == dtype and value.device == device and value.is_contiguous())
+
+
+def _selected_context(context, buffers, proof, device):
+    """只替层41元数据；writer 的独立 M slot_mapping 原对象保持。未知形态在执行前回原路。"""
+    name, backend = buffers.layer.layer_name, buffers.backend
+    md = context.attn_metadata.get(name)
+    m, s = proof["M"], proof["S"]
+    if (type(md) is not backend.TritonAttentionMetadata
+            or not isinstance(context.slot_mapping, dict)
+            or context.no_compile_layers.get(name) is not buffers.layer
+            or md.num_actual_tokens != m or md.max_query_len <= 1
+            or md.causal is not True or md.use_cascade or md.common_prefix_len != 0
+            or any(getattr(md, field) is not None for field in (
+                "cu_prefix_query_lens", "prefix_kv_lens", "suffix_kv_lens",
+                "scheduler_metadata", "prefix_scheduler_metadata", "mm_prefix_range", "mm_prefix_range_tensor"))
+            or type(md.seq_threshold_3D) is not int or not s <= md.seq_threshold_3D
+            or md.num_par_softmax_segments != 16
+            or not _tensor_shape(md.seq_lens, (s,), torch.int32, device)
+            or not _tensor_shape(md.query_start_loc, (s+1,), torch.int32, device)
+            or not _tensor_shape(md.slot_mapping, (m,), torch.int64, device)
+            or not _tensor_shape(context.slot_mapping.get(name), (m,), torch.int64, device)
+            or not isinstance(md.block_table, torch.Tensor) or md.block_table.ndim != 2
+            or md.block_table.shape[0] != s or md.block_table.dtype != torch.int32
+            or md.block_table.device != device or md.block_table.stride(1) != 1):
+        return None
+    threshold = md.seq_threshold_3D
+    if (not _tensor_shape(md.softmax_segm_output, (threshold, 16, 16, 128), torch.float32, device)
+            or not _tensor_shape(md.softmax_segm_max, (threshold, 16, 16), torch.float32, device)
+            or not _tensor_shape(md.softmax_segm_expsum, (threshold, 16, 16), torch.float32, device)):
+        return None
+    cache = buffers.layer.kv_cache
+    if (not isinstance(cache, torch.Tensor) or cache.ndim != 5
+            or tuple(cache.shape[1:]) != (2, 16, 2, 128)
+            or cache.dtype != torch.bfloat16 or cache.device != device):
+        return None
+    # replace 只复制 dataclass 声明字段；不能继承旧 C3 的动态 _SplitPlan。
+    selected = replace(md, num_actual_tokens=s, max_query_len=1,
+                       query_start_loc=buffers.query_start[:s+1])
+    if hasattr(selected, "_biv150_natural_prefix_plan"):
+        raise RuntimeError("selected-Q 元数据继承了旧 C3 plan")
+    return replace(context, attn_metadata={**context.attn_metadata, name: selected})
+
