+def _llama_attention_scope(module, llama):
+    # 拆开这个 Module.__call__ 前，排除原层 hooks/替换 forward 的额外消费者。
+    function = module.forward.__func__
+    return (function is llama.LlamaAttention.forward
+            and function.__globals__ is vars(llama)
+            and function.__code__.co_qualname == "LlamaAttention.forward"
+            and not module._forward_pre_hooks and not module._forward_hooks)
+
+
+def _attention_scope(layer, backend, attention_module):
+    """安装时验证当前 BF16 decoder 的原 writer/Attention 路径，不创建替代算子。"""
+    impl = layer.impl
+    return (type(layer) is attention_module.Attention
+            and "forward" not in layer.__dict__
+            and layer.forward.__func__ is attention_module.Attention.forward
+            and layer.forward.__func__.__globals__ is vars(attention_module)
+            and layer.attn_backend is backend.TritonAttentionBackend
+            and type(impl) is backend.TritonAttentionImpl
+            and not layer.attn_backend.forward_includes_kv_cache_update
+            and not layer.use_direct_call and layer.kv_sharing_target_layer_name is None
+            and (layer.num_heads, layer.num_kv_heads, layer.head_size, layer.head_size_v) == (16, 2, 128, 128)
+            and layer.kv_cache_torch_dtype == torch.bfloat16 and layer.kv_cache_dtype == "auto"
+            and layer.query_quant is None and not layer.calculate_kv_scales
+            and layer.quant_config is None and not layer.has_sink and not layer.use_mm_prefix
+            and layer.sliding_window is None and not layer.use_alibi_sqrt
+            and impl.attn_type == backend.AttentionType.DECODER
+            and impl.alibi_slopes is None and impl.sinks is None and impl.sliding_window == (-1, -1)
+            and impl.logits_soft_cap == 0 and impl.chunk_lookback == -1 and not impl.use_td
+            and not impl.use_alibi_sqrt and not impl._is_per_token_head_quant
+            and str(impl._kv_quant_mode) in ("0", "KVQuantMode.NONE"))
+
