index 0000000000000000000000000000000000000000..dedbbe07dfc2dbb7a58567e69ac430888bcae0b6
--- /dev/null
+++ b/vllm_fl/patches/biv150_sql_reflection.py
@@ -0,0 +1,64 @@
+"""Reflect one FlagGems SQLite configuration table per requested model.
+
+No database/config writes, persistent or negative cache, tuning changes, or
+device work. Install on the isolated Iluvatar plugin source before inference.
+Foreign-key dependency reflection keeps SQLAlchemy's original default.
+"""
+
+import functools
+import hashlib
+import importlib
+from pathlib import Path
+
+import sqlalchemy.ext.automap
+
+
+EXPECTED_SQL_SHA256 = "6dc19cb581d70154f14b95ed9112d682c6b5919b6cf3f8dea01a78a75ec0efd7"
+_MARKER = "_biv150_sql_targeted_reflection"
+
+
+def _targeted_builder(original):
+    @functools.wraps(original)
+    def build_sql_model_by_db(name, engine):
+        if engine.dialect.name != "sqlite":
+            return original(name, engine)
+        # A fresh base preserves the original per-call database/schema
+        # visibility and cannot mix models between engine instances.
+        base = sqlalchemy.ext.automap.automap_base()
+        base.prepare(
+            engine,
+            reflection_options={"only": lambda table_name, metadata: table_name == name},
+        )
+        # A predicate filters available tables. Unlike only=[name], a missing
+        # name remains None, allowing the original put_config creation path.
+        return base.classes.get(name)
+
+    setattr(build_sql_model_by_db, _MARKER, True)
+    return build_sql_model_by_db
+
+
+def install(*, module=None, vendor_name=None):
+    """Replace only the audited static reflection implementation, fail closed.
+
+    The optional dependency arguments make the real SQLAlchemy CPU gate
+    independent of importing FlagGems/vLLM and initializing their platforms.
+    Runtime callers use install() without overrides.
+    """
+    if vendor_name is None:
+        vendor_name = importlib.import_module("vllm.platforms").current_platform.vendor_name
+    if vendor_name != "iluvatar":
+        return {"installed": False, "reason": "non-iluvatar platform uses original reflection"}
+    if module is None:
+        module = importlib.import_module("flag_gems.utils.models.sql")
+    source = Path(module.__file__)
+    actual = hashlib.sha256(source.read_bytes()).hexdigest()
+    if actual != EXPECTED_SQL_SHA256:
+        raise RuntimeError(f"unaudited FlagGems SQL source: {source}: {actual}")
+    cls = module.SQLPersistantModel
+    original = cls.build_sql_model_by_db
+    if not getattr(original, _MARKER, False):
+        cls.build_sql_model_by_db = staticmethod(_targeted_builder(original))
+    print("BIV150_SQL_REFLECTION_INSTALLED sqlite_targeted_only=1", flush=True)
+    return {"installed": True, "scope": "FlagGems SQLite configuration table reflection",
+            "sql_sha256": actual, "model_cache_changed": False,
+            "missing_tables_cached": False, "database_rows_changed": False}
diff --git a/vllm_fl/patches/biv150_top_p_triton.py b/vllm_fl/patches/biv150_top_p_triton.py
new file mode 100644
index 0000000000000000000000000000000000000000..99b84acc8cef0f5f39f7b3ef9dd0a7eea998eed0
--- /dev/null
+++ b/vllm_fl/patches/biv150_top_p_triton.py
@@ -0,0 +1,344 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded histogram-zoom top-p filtering for BI-V150.
+
+The fixed-work histogram refinement replaces the upstream top-p-only path's
+repeated full-vocabulary probability-sum bisection. It keeps the public
+``apply_top_k_top_p_triton`` interface and changes only the top-p-only branch.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+_MAX_SPLITS = 1
+_NBINS = 256
+_ZOOM_ROUNDS = 2
+_LOGIT_RANGE = 20.0
+_BLOCK = 4096
+_CACHE: dict[tuple[torch.device, int, int], "_TopPWorkspace"] = {}
+
+
+@triton.jit
+def _row_stats_partial(
+    LOGITS,
+    MAX_PART,
+    SUM_PART,
+    stride_row,
+    VOCAB_SIZE: tl.constexpr,
+    NUM_SPLITS: tl.constexpr,
+    MAX_SPLITS: tl.constexpr,
+    TILES_PER_SPLIT: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    split = tl.program_id(1)
+    offs = tl.arange(0, BLOCK)
+    start = split * TILES_PER_SPLIT * BLOCK
+    row_max = float("-inf")
+    row_sum = 0.0
+    for tile in range(TILES_PER_SPLIT):
+        idx = start + tile * BLOCK + offs
+        values = tl.load(
+            LOGITS + row * stride_row + idx,
+            mask=idx < VOCAB_SIZE,
+            other=float("-inf"),
+        )
+        tile_max = tl.max(values, axis=0)
+        new_max = tl.maximum(row_max, tile_max)
+        safe_new_max = tl.where(new_max == float("-inf"), 0.0, new_max)
+        old_scale = tl.where(
+            row_max == float("-inf"),
+            0.0,
+            tl.exp(row_max - safe_new_max),
+        )
+        row_sum = row_sum * old_scale + tl.sum(
+            tl.exp(values - safe_new_max), axis=0
+        )
+        row_max = new_max
+    tl.store(MAX_PART + row * MAX_SPLITS + split, row_max)
+    tl.store(SUM_PART + row * MAX_SPLITS + split, row_sum)
+
+
+@triton.jit
+def _row_max_reduce(
+    MAX_PART,
+    SUM_PART,
+    MAX_ROW,
+    Z_ROW,
+    PREFIX_MASS,
+    LO,
+    HI,
+    NUM_SPLITS: tl.constexpr,
+    MAX_SPLITS: tl.constexpr,
+    RANGE: tl.constexpr,
+):
+    row = tl.program_id(0)
+    offs = tl.arange(0, MAX_SPLITS)
+    values = tl.load(
+        MAX_PART + row * MAX_SPLITS + offs,
+        mask=offs < NUM_SPLITS,
+        other=float("-inf"),
+    )
+    row_max = tl.max(values, axis=0)
+    safe_max = tl.where(row_max == float("-inf"), 0.0, row_max)
+    partial_sums = tl.load(
+        SUM_PART + row * MAX_SPLITS + offs,
+        mask=offs < NUM_SPLITS,
+        other=0.0,
+    )
+    row_sum = tl.sum(partial_sums * tl.exp(values - safe_max), axis=0)
+    has_finite = row_max != float("-inf")
+    tl.store(MAX_ROW + row, row_max)
+    tl.store(Z_ROW + row, row_sum)
+    tl.store(PREFIX_MASS + row, 0.0)
+    tl.store(LO + row, tl.where(has_finite, row_max - RANGE, 0.0))
+    tl.store(HI + row, tl.where(has_finite, row_max, 1.0))
+
+
+@triton.jit
+def _weighted_hist(
+    LOGITS,
+    MAX_ROW,
+    LO,
+    HI,
+    HIST,
+    stride_row,
+    VOCAB_SIZE: tl.constexpr,
+    NUM_SPLITS: tl.constexpr,
+    TILES_PER_SPLIT: tl.constexpr,
+    NBINS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    split = tl.program_id(1)
+    offs = tl.arange(0, BLOCK)
+    row_max = tl.load(MAX_ROW + row)
+    safe_max = tl.where(row_max == float("-inf"), 0.0, row_max)
+    lo = tl.load(LO + row)
+    hi = tl.load(HI + row)
+    scale = NBINS / (hi - lo)
+    start = split * TILES_PER_SPLIT * BLOCK
+    for tile in range(TILES_PER_SPLIT):
+        idx = start + tile * BLOCK + offs
+        valid = idx < VOCAB_SIZE
+        values = tl.load(
+            LOGITS + row * stride_row + idx,
+            mask=valid,
+            other=float("-inf"),
+        )
+        bins = ((values - lo) * scale).to(tl.int32)
+        bins = tl.minimum(tl.maximum(bins, 0), NBINS - 1)
+        weights = tl.exp(values - safe_max)
+        active = (
+            valid
+            & (row_max != float("-inf"))
+            & (values >= lo)
+            & (values <= hi)
+        )
+        tl.atomic_add(HIST + row * NBINS + bins, weights, mask=active)
+
+
+@triton.jit
+def _hist_walk(
+    HIST,
+    P,
+    Z_ROW,
+    PREFIX_MASS,
+    LO,
+    HI,
+    TAU,
+    NBINS: tl.constexpr,
+    FINAL: tl.constexpr,
+):
+    row = tl.program_id(0)
+    offs = tl.arange(0, NBINS)
+    reversed_mass = tl.load(HIST + row * NBINS + (NBINS - 1 - offs))
+    cumulative = tl.cumsum(reversed_mass, axis=0)
+    p = tl.load(P + row).to(tl.float32)
+    total_mass = tl.load(Z_ROW + row)
+    previous_mass = tl.load(PREFIX_MASS + row)
+
+    target = p * total_mass
+    reached = (previous_mass + cumulative) >= target
+    crossing = tl.argmax(reached.to(tl.int32), axis=0)
+    selected_prefix = tl.where(
+        crossing > 0,
+        tl.sum(
+            tl.where(offs == tl.maximum(crossing - 1, 0), cumulative, 0.0),
+            axis=0,
+        ),
+        0.0,
+    )
+    tl.store(PREFIX_MASS + row, previous_mass + selected_prefix)
+
+    bin_id = NBINS - 1 - crossing
+    lo = tl.load(LO + row)
+    hi = tl.load(HI + row)
+    width = (hi - lo) / NBINS
+    lower = lo + bin_id * width
+    upper = lower + width
+    if FINAL:
+        tl.store(TAU + row, lower)
+    else:
+        tl.store(LO + row, lower)
+        tl.store(HI + row, upper)
+
+
+@triton.jit
+def _apply_mask(
+    LOGITS,
+    MAX_ROW,
+    P,
+    TAU,
+    stride_row,
+    VOCAB_SIZE: tl.constexpr,
+    NUM_SPLITS: tl.constexpr,
+    TILES_PER_SPLIT: tl.constexpr,
+    MASK_VALUE: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    split = tl.program_id(1)
+    offs = tl.arange(0, BLOCK)
+    p = tl.load(P + row)
+    tau = tl.load(TAU + row)
+    row_max = tl.load(MAX_ROW + row)
+    start = split * TILES_PER_SPLIT * BLOCK
+    for tile in range(TILES_PER_SPLIT):
+        idx = start + tile * BLOCK + offs
+        valid = idx < VOCAB_SIZE
+        values = tl.load(
+            LOGITS + row * stride_row + idx,
+            mask=valid,
+            other=float("-inf"),
+        )
+        if p >= 1.0:
+            keep = valid
+        elif p <= 0.0:
+            keep = valid & (values == row_max)
+        else:
+            keep = valid & (values >= tau)
+        tl.store(
+            LOGITS + row * stride_row + idx,
+            tl.where(keep, values, MASK_VALUE),
+            mask=valid,
+        )
+
+
+class _TopPWorkspace:
+    def __init__(self, batch_size: int, vocab_size: int, device: torch.device):
+        self.batch_size = batch_size
+        self.vocab_size = vocab_size
+        self.tiles_per_split = triton.cdiv(
+            triton.cdiv(vocab_size, _BLOCK), _MAX_SPLITS
+        )
+        fp32 = {"device": device, "dtype": torch.float32}
+        self.max_part = torch.empty(batch_size, _MAX_SPLITS, **fp32)
+        self.sum_part = torch.empty(batch_size, _MAX_SPLITS, **fp32)
+        self.max_row = torch.empty(batch_size, **fp32)
+        self.z_row = torch.empty(batch_size, **fp32)
+        self.prefix_mass = torch.empty(batch_size, **fp32)
+        self.lo = torch.empty(batch_size, **fp32)
+        self.hi = torch.empty(batch_size, **fp32)
+        self.tau = torch.empty(batch_size, **fp32)
+        self.hist = torch.empty(batch_size, _NBINS, **fp32)
+
+
+def _get_workspace(
+    batch_size: int, vocab_size: int, device: torch.device
+) -> _TopPWorkspace:
+    key = (device, batch_size, vocab_size)
+    workspace = _CACHE.get(key)
+    if workspace is None:
+        workspace = _TopPWorkspace(batch_size, vocab_size, device)
+        _CACHE[key] = workspace
+    return workspace
+
+
+def apply_top_p_hist_triton(
+    logits: torch.Tensor,
+    p: torch.Tensor,
+    mask_value: float = float("-inf"),
+) -> torch.Tensor:
+    """Apply top-p masking with three fixed histogram-refinement passes."""
+    assert logits.ndim == 2
+    assert logits.dtype == torch.float32
+    assert logits.stride(1) == 1
+    assert p.ndim == 1 and p.shape[0] == logits.shape[0]
+    if logits.shape[0] == 0:
+        return logits
+
+    batch_size, vocab_size = logits.shape
+    workspace = _get_workspace(batch_size, vocab_size, logits.device)
+    grid = (batch_size, _MAX_SPLITS)
+
+    _row_stats_partial[grid](
+        logits,
+        workspace.max_part,
+        workspace.sum_part,
+        logits.stride(0),
+        VOCAB_SIZE=vocab_size,
+        NUM_SPLITS=_MAX_SPLITS,
+        MAX_SPLITS=_MAX_SPLITS,
+        TILES_PER_SPLIT=workspace.tiles_per_split,
+        BLOCK=_BLOCK,
+        num_warps=8,
+    )
+    _row_max_reduce[(batch_size,)](
+        workspace.max_part,
+        workspace.sum_part,
+        workspace.max_row,
+        workspace.z_row,
+        workspace.prefix_mass,
+        workspace.lo,
+        workspace.hi,
+        NUM_SPLITS=_MAX_SPLITS,
+        MAX_SPLITS=_MAX_SPLITS,
+        RANGE=_LOGIT_RANGE,
+        num_warps=1,
+    )
+    for round_no in range(_ZOOM_ROUNDS, 0, -1):
+        workspace.hist.zero_()
+        _weighted_hist[grid](
+            logits,
+            workspace.max_row,
+            workspace.lo,
+            workspace.hi,
+            workspace.hist,
+            logits.stride(0),
+            VOCAB_SIZE=vocab_size,
+            NUM_SPLITS=_MAX_SPLITS,
+            TILES_PER_SPLIT=workspace.tiles_per_split,
+            NBINS=_NBINS,
+            BLOCK=_BLOCK,
+            num_warps=8,
+        )
+        _hist_walk[(batch_size,)](
+            workspace.hist,
+            p,
+            workspace.z_row,
+            workspace.prefix_mass,
+            workspace.lo,
+            workspace.hi,
+            workspace.tau,
+            NBINS=_NBINS,
+            FINAL=round_no == 1,
+            num_warps=1,
+        )
+
+    _apply_mask[grid](
+        logits,
+        workspace.max_row,
+        p,
+        workspace.tau,
+        logits.stride(0),
+        VOCAB_SIZE=vocab_size,
+        NUM_SPLITS=_MAX_SPLITS,
+        TILES_PER_SPLIT=workspace.tiles_per_split,
+        MASK_VALUE=mask_value,
+        BLOCK=_BLOCK,
+        num_warps=8,
+    )
+    return logits
