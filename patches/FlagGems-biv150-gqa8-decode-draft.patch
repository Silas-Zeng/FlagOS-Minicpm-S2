+def _select_varlen_fwd_config_name(
+    *,
+    vendor_name: str,
+    seqlenq_ngroups_swapped: bool,
+    max_seqlen_q: int,
+    avg_rows_per_cta: float,
+) -> str:
+    """Select a paged/varlen FlashAttention launch heuristic.
+
+    Iluvatar's 64-thread warp and 16-SM BI-V150 benefit from matching the
+    packed GQA decode tile to the exact query-group extent. With 16 query
+    heads and 2 KV heads this extent is 8, so a 16-row tile computes a masked
+    half-tile for every decode request.
+    """
+    if avg_rows_per_cta > 64:
+        default_name = "mha_block_128"
+    elif avg_rows_per_cta > 32:
+        default_name = "mha_block_64"
+    elif avg_rows_per_cta > 16:
+        default_name = "mha_block_32"
+    else:
+        default_name = "mha_block_16"
+
+    if vendor_name == "mthreads":
+        return "mha_block_32"
+
+    if (
+        vendor_name == "iluvatar"
+        and seqlenq_ngroups_swapped
+        and max_seqlen_q == 8
+    ):
+        return "mha_biv150_gqa8_decode"
+
+    return default_name
+
