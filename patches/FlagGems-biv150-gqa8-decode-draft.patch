diff --git a/tests/test_varlen_fwd_heuristics.py b/tests/test_varlen_fwd_heuristics.py
new file mode 100644
index 00000000..f870a734
--- /dev/null
+++ b/tests/test_varlen_fwd_heuristics.py
@@ -0,0 +1,56 @@
+# Copyright 2026 FlagOS Contributors
