+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+
+import importlib
+
+from flag_gems.ops.flash_api import _select_varlen_fwd_config_name
+
+
+def test_iluvatar_uses_exact_tile_for_packed_gqa8_decode():
+    selected = _select_varlen_fwd_config_name(
+        vendor_name="iluvatar",
+        seqlenq_ngroups_swapped=True,
+        max_seqlen_q=8,
+        avg_rows_per_cta=8,
+    )
+
+    assert selected == "mha_biv150_gqa8_decode"
+
+
+def test_iluvatar_prefill_keeps_general_heuristic():
+    selected = _select_varlen_fwd_config_name(
+        vendor_name="iluvatar",
+        seqlenq_ngroups_swapped=False,
+        max_seqlen_q=16384,
+        avg_rows_per_cta=16384,
+    )
+
+    assert selected == "mha_block_128"
+
+
+def test_other_vendors_keep_general_heuristic():
+    selected = _select_varlen_fwd_config_name(
+        vendor_name="nvidia",
+        seqlenq_ngroups_swapped=True,
+        max_seqlen_q=8,
+        avg_rows_per_cta=8,
+    )
+
+    assert selected == "mha_block_16"
+
+
+def test_iluvatar_gqa8_decode_config_is_exact_tile():
+    module = importlib.import_module(
+        "flag_gems.runtime.backend._iluvatar.heuristics_config_utils"
+    )
+    config = module.HEURISTICS_CONFIGS["mha_biv150_gqa8_decode"]
+
+    assert config["BLOCK_M"](None) == 8
+    assert config["BLOCK_N"](None) == 32
+    assert config["num_warps"](None) == 4
+    assert config["num_stages"](None) == 3
